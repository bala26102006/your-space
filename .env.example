# ========================================================
# Your Space — Environment Configuration Example
# ========================================================
# Copy this file to .env to configure optional cloud sync
# and AI services. The application runs 100% offline via
# Dexie IndexedDB even without these variables defined.
# ========================================================

# Supabase Cloud Sync (Optional)
# Obtain these from your Supabase Project Settings -> API
# Run supabase_schema.sql in the SQL Editor to set up cloud tables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini AI Integration (Optional)
# For AI auto-organize, summarize, and idea expansion features.
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_AI_MODEL=gemini-1.5-flash
